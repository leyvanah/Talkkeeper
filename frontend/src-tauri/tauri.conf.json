{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Talkkeeper",
    "version": "0.2.34",
    "identifier": "com.meetily.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "node node_modules/next/dist/bin/next dev -p 3118",
        "beforeBuildCommand": "node node_modules/next/dist/bin/next build"
    },
    "app": {
        "windows": [
            {
                "title": "Talkkeeper",
                "width": 1100,
                "height": 700,
                "minWidth": 960,
                "minHeight": 600,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "theme": "Dark",
                "decorations": false,
                "shadow": true
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data:",
                "media-src": "'self' recording: http://recording.localhost https://recording.localhost blob: data:",
                "connect-src": "'self' recording: http://recording.localhost https://recording.localhost",
                "base-uri": "'self'",
                "form-action": "'none'"
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window: window controls, events, the app version, save and open dialogs, notifications, writing the file the owner picked in a dialog",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:event:default",
                        "core:window:default",
                        "core:window:allow-set-theme",
                        "core:app:default",
                        "core:window:allow-set-title",
                        "core:window:allow-minimize",
                        "core:window:allow-toggle-maximize",
                        "core:window:allow-is-maximized",
                        "core:window:allow-start-dragging",
                        "core:window:allow-start-resize-dragging",
                        "core:window:allow-close",
                        "dialog:allow-save",
                        "dialog:allow-open",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "fs:allow-write-file"
                    ]
                },
                {
                    "identifier": "minibar",
                    "description": "Compact recording bar: events, its own window and theme, dragging. No files, dialogs or notifications",
                    "windows": [
                        "minibar"
                    ],
                    "permissions": [
                        "core:event:default",
                        "core:window:default",
                        "core:window:allow-set-theme",
                        "core:window:allow-start-dragging"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "templates/*.json",
            "resources/diarization/*",
            "runtime-deps/*",
            "installer-variants/*",
            "licenses/**/*"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/llama-helper-cpu",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1",
            "webviewInstallMode": {
                "type": "embedBootstrapper",
                "silent": true
            },
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": false,
                "template": "./windows/installer.nsi",
                "installerHooks": "./windows/installer-hooks.nsh",
                "installerIcon": "./icons/icon.ico",
                "languages": ["English", "Russian"],
                "customLanguageFiles": {
                    "English": "./windows/English.nsh",
                    "Russian": "./windows/Russian.nsh"
                }
            }
        }
    }
}
